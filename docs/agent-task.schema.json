{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-controlled independent task manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "task_id", "review_tier", "base_commit", "authorized", "protected", "checks", "authorized_external_actions"],
  "properties": {
    "protocol_version": {"const": "1.1"},
    "task_id": {"type": "string", "minLength": 1},
    "review_tier": {"enum": ["lightweight", "standard", "enhanced"]},
    "base_commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "authorized": {"$ref": "#/$defs/paths"},
    "protected": {"$ref": "#/$defs/paths"},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "argv", "kind", "timeout_seconds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "kind": {"enum": ["tests", "build", "review", "other"]},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}
        }
      }
    },
    "authorized_external_actions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action", "target", "approval_ref"],
        "properties": {
          "action": {"enum": ["commit", "push", "pr", "merge", "deploy", "destructive", "other"]},
          "target": {"type": "string", "minLength": 1},
          "approval_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {"paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
